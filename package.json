{
  "name": "better-csharp-references",
  "displayName": "Better C# References",
  "description": "Find All References for C# as a collapsible folder tree, grouped into Definition / Write / Read.",
  "version": "1.0.0",
  "publisher": "techital",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Techital-jonathan/VSCode_Extension_BetterC-References.git"
  },
  "bugs": {
    "url": "https://github.com/Techital-jonathan/VSCode_Extension_BetterC-References/issues"
  },
  "homepage": "https://github.com/Techital-jonathan/VSCode_Extension_BetterC-References#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "c#",
    "csharp",
    "dotnet",
    "references",
    "find all references",
    "read write",
    "roslyn",
    "tree"
  ],
  "galleryBanner": {
    "color": "#24273A",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:csharp"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "refsTree",
          "title": "C# References",
          "icon": "media/references.svg"
        }
      ]
    },
    "views": {
      "refsTree": [
        {
          "id": "refsTree.results",
          "name": "References",
          "icon": "media/references.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "refsTree.find",
        "title": "Find All References (Tree)",
        "category": "C# References",
        "icon": "$(references)"
      },
      {
        "command": "refsTree.showAsTree",
        "title": "View as Tree",
        "category": "C# References",
        "icon": "$(list-tree)"
      },
      {
        "command": "refsTree.showAsList",
        "title": "View as List",
        "category": "C# References",
        "icon": "$(list-flat)"
      },
      {
        "command": "refsTree.groupByAccess",
        "title": "Group by Read/Write",
        "category": "C# References",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "refsTree.ungroupByAccess",
        "title": "Don't Group by Read/Write",
        "category": "C# References",
        "icon": "$(ungroup-by-ref-type)"
      },
      {
        "command": "refsTree.expandAll",
        "title": "Expand All",
        "category": "C# References",
        "icon": "$(expand-all)"
      },
      {
        "command": "refsTree.refresh",
        "title": "Rerun Search",
        "category": "C# References",
        "icon": "$(refresh)"
      },
      {
        "command": "refsTree.clear",
        "title": "Clear Results",
        "category": "C# References",
        "icon": "$(clear-all)"
      },
      {
        "command": "refsTree.remove",
        "title": "Dismiss",
        "category": "C# References",
        "icon": "$(close)"
      },
      {
        "command": "refsTree.copyPath",
        "title": "Copy Path",
        "category": "C# References"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "refsTree.showAsList",
          "when": "view == refsTree.results && refsTree.viewMode == tree",
          "group": "navigation@1"
        },
        {
          "command": "refsTree.showAsTree",
          "when": "view == refsTree.results && refsTree.viewMode == list",
          "group": "navigation@1"
        },
        {
          "command": "refsTree.groupByAccess",
          "when": "view == refsTree.results && !refsTree.groupByAccess",
          "group": "navigation@2"
        },
        {
          "command": "refsTree.ungroupByAccess",
          "when": "view == refsTree.results && refsTree.groupByAccess",
          "group": "navigation@2"
        },
        {
          "command": "refsTree.expandAll",
          "when": "view == refsTree.results && refsTree.hasResults",
          "group": "navigation@3"
        },
        {
          "command": "refsTree.refresh",
          "when": "view == refsTree.results && refsTree.hasResults",
          "group": "navigation@4"
        },
        {
          "command": "refsTree.clear",
          "when": "view == refsTree.results && refsTree.hasResults",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "refsTree.remove",
          "when": "view == refsTree.results && viewItem =~ /^(reference|file|folder|group)$/",
          "group": "inline"
        },
        {
          "command": "refsTree.remove",
          "when": "view == refsTree.results && viewItem =~ /^(reference|file|folder|group)$/",
          "group": "1_modify"
        },
        {
          "command": "refsTree.copyPath",
          "when": "view == refsTree.results && viewItem =~ /^(reference|file|folder)$/",
          "group": "2_copy"
        }
      ],
      "editor/context": [
        {
          "command": "refsTree.find",
          "when": "editorLangId == csharp",
          "group": "0_navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "refsTree.find",
          "when": "editorLangId == csharp"
        },
        {
          "command": "refsTree.remove",
          "when": "false"
        },
        {
          "command": "refsTree.copyPath",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "refsTree.find",
        "key": "shift+alt+f12",
        "when": "editorTextFocus && editorLangId == csharp && config.refsTree.replaceFindAllReferences"
      }
    ],
    "configuration": {
      "title": "Better C# References",
      "properties": {
        "refsTree.replaceFindAllReferences": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use `Shift+Alt+F12` (Find All References) for this extension in C# files, instead of VS Code's built-in References view. Turn off to keep the built-in behavior; the command stays available in the editor context menu and Command Palette."
        },
        "refsTree.defaultViewMode": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "default": "tree",
          "description": "How files are shown the first time: as a folder tree or as a flat list. Toggling in the view is remembered."
        },
        "refsTree.defaultGroupByAccess": {
          "type": "boolean",
          "default": true,
          "description": "Group references into Definition / Write / Read the first time. Toggling in the view is remembered."
        },
        "refsTree.compactFolders": {
          "type": "boolean",
          "default": true,
          "description": "Join folder chains that only contain a single sub-folder into one node (e.g. src/Core/Services)."
        },
        "refsTree.namedArgumentsAsWrite": {
          "type": "boolean",
          "default": true,
          "description": "Count named arguments like `new PartDto(InStock: value)` as writes. Roslyn reports them as plain references to the constructor parameter, but for records and primary constructors they set the property."
        },
        "refsTree.autoExpandLimit": {
          "type": "number",
          "default": 250,
          "description": "Expand files automatically when the result has at most this many references. Above it, files start collapsed."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "vsce package --out better-csharp-references.vsix",
    "test:unit": "npm run compile && node --test \"out/test/unit/**/*.test.js\"",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "~5.9.3"
  }
}
